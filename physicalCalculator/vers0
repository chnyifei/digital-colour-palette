#include <stdio.h>
#include <string.h>
#include <math.h>

// 1. CONSTANTS & CLAY IDs
#define CLAY_YELLOW  0
#define CLAY_RED     1
#define CLAY_MAGENTA 2
#define CLAY_BLUE    3
#define CLAY_GREEN   4
#define CLAY_WHITE   5
#define CLAY_BLACK   6

// 2. STRUCT DEFINITIONS
typedef struct {
    const char* name;     
    int colour_a;          
    int parts_a;          
    int colour_b;          
    int parts_b;          
} columnFormula;

typedef struct {
    float ratio[7];
    float grams[7]; 
} mixResult;

typedef struct {
    mixResult grams;
    mixResult ratios;
} calculationOutput;

// 3. GLOBAL DATABASE
const columnFormula COLUMNS[24] = {
    // --- Yellow to Red ---
    { "Y",    CLAY_YELLOW,   1,  0,             0 }, 
    { "YI",   CLAY_YELLOW,  80,  CLAY_RED,      1 }, 
    { "YII",  CLAY_YELLOW,  20,  CLAY_RED,      1 }, 
    { "YIII", CLAY_YELLOW,   4,  CLAY_RED,      1 }, 
    { "YIV",  CLAY_YELLOW,   2,  CLAY_RED,      3 }, 

    // --- Red to Magenta ---
    { "R",    CLAY_RED,      1,  0,             0 }, 
    { "RI",   CLAY_RED,      3,  CLAY_MAGENTA,  2 }, 
    { "RII",  CLAY_RED,      1,  CLAY_MAGENTA,  4 }, 

    // --- Magenta to Blue ---
    { "M",    CLAY_MAGENTA,  1,  0,             0 }, 
    { "MI",   CLAY_MAGENTA, 20,  CLAY_BLUE,     1 }, 
    { "MII",  CLAY_MAGENTA,  4,  CLAY_BLUE,     1 }, 
    { "MIII", CLAY_MAGENTA,  3,  CLAY_BLUE,     2 }, 
    { "MIV",  CLAY_MAGENTA,  3,  CLAY_BLUE,     7 }, 
    { "MV",   CLAY_MAGENTA,  1,  CLAY_BLUE,     9 }, 

    // --- Blue to Green ---
    { "B",    CLAY_BLUE,     1,  0,             0 }, 
    { "BI",   CLAY_BLUE,     9,  CLAY_GREEN,    1 }, 
    { "BII",  CLAY_BLUE,     7,  CLAY_GREEN,    3 }, 
    { "BIII", CLAY_BLUE,     2,  CLAY_GREEN,    3 }, 

    // --- Green to Yellow ---
    { "G",    CLAY_GREEN,    1,  0,             0 }, 
    { "GI",   CLAY_GREEN,    9,  CLAY_YELLOW,   1 }, 
    { "GII",  CLAY_GREEN,    2,  CLAY_YELLOW,   3 }, 
    { "GIII", CLAY_GREEN,    1,  CLAY_YELLOW,   9 }, 
    { "GIV",  CLAY_GREEN,    1,  CLAY_YELLOW,  40 }, 
    { "GV",   CLAY_GREEN,    1,  CLAY_YELLOW, 120 }  
};

// 4. GCD UTILITIES (Euclid's Algorithm)
int findGCD(int a, int b) {
    while (b != 0) {
        int temp = b;
        b = a % b;
        a = temp;
    }
    return a;
}

// 5. MATH ENGINE FUNCTION
calculationOutput calculateMix(int columnIndex, int tintShade, float totalMass) {
    calculationOutput output = {0};
    
    columnFormula col = COLUMNS[columnIndex];
    float total_color_parts = (float)(col.parts_a + col.parts_b);
    
    float middleColAmount = totalMass;

    // --- STEP 1: CALCULATE DILUTERS AND PORTIONS ---
    if (tintShade == -3) { // 1K + 5 parts color mix
        float black_fraction = 1.0f / 6.0f;
        output.grams.grams[CLAY_BLACK] = totalMass * black_fraction;
        middleColAmount = totalMass - output.grams.grams[CLAY_BLACK];
        
        output.ratios.ratio[CLAY_BLACK] = total_color_parts * 1.0f;
        output.ratios.ratio[col.colour_a] = col.parts_a * 5.0f;
        output.ratios.ratio[col.colour_b] = col.parts_b * 5.0f;
    }
    
    else if (tintShade == -2) { // 1K + 20 parts color mix
        float black_fraction = 1.0f / 21.0f;
        output.grams.grams[CLAY_BLACK] = totalMass * black_fraction;
        middleColAmount = totalMass - output.grams.grams[CLAY_BLACK];
        
        output.ratios.ratio[CLAY_BLACK] = total_color_parts * 1.0f;
        output.ratios.ratio[col.colour_a] = col.parts_a * 20.0f;
        output.ratios.ratio[col.colour_b] = col.parts_b * 20.0f;
    }
    
    else if (tintShade == -1) { // 1K + 80 parts color mix
        float black_fraction = 1.0f / 81.0f;
        output.grams.grams[CLAY_BLACK] = totalMass * black_fraction;
        middleColAmount = totalMass - output.grams.grams[CLAY_BLACK];
        
        output.ratios.ratio[CLAY_BLACK] = total_color_parts * 1.0f;
        output.ratios.ratio[col.colour_a] = col.parts_a * 80.0f;
        output.ratios.ratio[col.colour_b] = col.parts_b * 80.0f;
    }
    
    else if (tintShade == 1) { // 1W + 1 part color mix
        float white_fraction = 1.0f / 2.0f;
        output.grams.grams[CLAY_WHITE] = totalMass * white_fraction;
        middleColAmount = totalMass - output.grams.grams[CLAY_WHITE];
        
        output.ratios.ratio[CLAY_WHITE] = total_color_parts * 1.0f;
        output.ratios.ratio[col.colour_a] = col.parts_a * 1.0f;
        output.ratios.ratio[col.colour_b] = col.parts_b * 1.0f;
    }
    
    else if (tintShade == 2) { // 4W + 1 part color mix
        float white_fraction = 4.0f / 5.0f;
        output.grams.grams[CLAY_WHITE] = totalMass * white_fraction;
        middleColAmount = totalMass - output.grams.grams[CLAY_WHITE];
        
        output.ratios.ratio[CLAY_WHITE] = total_color_parts * 4.0f;
        output.ratios.ratio[col.colour_a] = col.parts_a * 1.0f;
        output.ratios.ratio[col.colour_b] = col.parts_b * 1.0f;
    }
    
    else if (tintShade == 3) { // 20W + 1 part color mix
        float white_fraction = 20.0f / 21.0f;
        output.grams.grams[CLAY_WHITE] = totalMass * white_fraction;
        middleColAmount = totalMass - output.grams.grams[CLAY_WHITE];
        
        output.ratios.ratio[CLAY_WHITE] = total_color_parts * 20.0f;
        output.ratios.ratio[col.colour_a] = col.parts_a * 1.0f;
        output.ratios.ratio[col.colour_b] = col.parts_b * 1.0f;
    }
    
    else { // tintShade == 0 (The Main Color Wheel row)
        output.ratios.ratio[col.colour_a] = col.parts_a * 1.0f;
        output.ratios.ratio[col.colour_b] = col.parts_b * 1.0f;
    }

    // --- STEP 2: DISTRIBUTE INTERNAL MIDDLE COLOR PARTS ---
    if (total_color_parts > 0.0f) {
        output.grams.grams[col.colour_a] = middleColAmount * ((float)col.parts_a / total_color_parts);
        if (col.parts_b > 0) {
            output.grams.grams[col.colour_b] = middleColAmount * ((float)col.parts_b / total_color_parts);
        }
    }

    // --- STEP 3: CALCULATE GCD REDUCTION ON WHOLE RATIOS ---
    int roundedRatios[7] = {0};
    int overallGCD = 0;

    // Convert floats to nearest whole integers for analysis
    for (int i = 0; i < 7; i++) {
        roundedRatios[i] = (int)roundf(output.ratios.ratio[i]);
    }

    // Seed overallGCD with the first non-zero integer we find
    for (int i = 0; i < 7; i++) {
        if (roundedRatios[i] > 0) {
            overallGCD = roundedRatios[i];
            break;
        }
    }

    // Process the remaining array elements to find the absolute GCD
    if (overallGCD > 1) {
        for (int i = 0; i < 7; i++) {
            if (roundedRatios[i] > 0) {
                overallGCD = findGCD(overallGCD, roundedRatios[i]);
            }
        }
    }

    // If a valid common divisor greater than 1 is found, divide them all down
    if (overallGCD > 1) {
        for (int i = 0; i < 7; i++) {
            output.ratios.ratio[i] = (float)roundedRatios[i] / overallGCD;
        }
    }

    return output;
}

// 6. TEST INTERFACE; EXCLUDE FROM FINAL
int main() {
    int colIndex = 0;
    int tintShade = 0;
    float targetMass = 0.0f;

    printf("=== FIMO MECHATRONIC CLAY CALCULATOR ===\n\n");

    printf("Enter Column Index (0 to 23):\n");
    printf("  [0=Y, 1=YI, 2=YII, 3=YIII, 4=YIV, 5=R, 8=M, 14=B, 18=G, 23=GV...]\n");
    printf("Choice: ");
    if (scanf("%d", &colIndex) != 1 || colIndex < 0 || colIndex > 23) {
        printf("Invalid column index!\n");
        return 1;
    }

    printf("\nEnter Tint/Shade modifier (-3 to +3):\n");
    printf("  [-3 = 1K+5, -2 = 1K+20, -1 = 1K+80]\n");
    printf("  [ 0 = Pure Color Wheel Row          ]\n");
    printf("  [+1 = 1W+1,  +2 = 4W+1,   +3 = 20W+1]\n");
    printf("Choice: ");
    if (scanf("%d", &tintShade) != 1 || tintShade < -3 || tintShade > 3) {
        printf("Invalid modifier scope!\n");
        return 1;
    }

    printf("\nEnter desired final mass in grams (e.g. 25.0):\n");
    printf("Mass: ");
    if (scanf("%f", &targetMass) != 1 || targetMass <= 0.0f) {
        printf("Invalid mass!\n");
        return 1;
    }

    // Execute engine
    calculationOutput result = calculateMix(colIndex, tintShade, targetMass);

    const char* colorNames[7] = {"Yellow", "Red", "Magenta", "Blue", "Green", "White", "Black"};

    printf("\n========================================\n");
    printf("RECIPE TARGET: %s (Row Modifier: %d)\n", COLUMNS[colIndex].name, tintShade);
    printf("TOTAL TARGET WEIGHT: %.2fg\n", targetMass);
    printf("========================================\n\n");

    printf("--- WEIGHING SCALE MODE ---\n");
    for (int i = 0; i < 7; i++) {
        if (result.grams.grams[i] > 0.001f) {
            printf("  * %-8s : %.3fg\n", colorNames[i], result.grams.grams[i]);
        }
    }

    printf("\n--- WHOLE NUMBER PARTS MODE ---\n");
    for (int i = 0; i < 7; i++) {
        if (result.ratios.ratio[i] > 0.1f) {
            printf("  * %-8s : %.0f parts\n", colorNames[i], result.ratios.ratio[i]);
        }
    }
    printf("========================================\n");

    return 0;
}