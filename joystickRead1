//purpose: read joystick inputs
//ignore centre (200~800 centre)
//ignore corners
//zones: up, down, left, right, none
//lock inputs until shift into a different zone
//note: with the pins facing left and the joystick facing up, up and down are flipped -- so they're flipped in the code too
//hold for <= 400ms: register one move; hold for < 400ms: register repeated moves every 150ms

//NOTE: THIS IS THE SECOND VERSION OF THIS CODE; THE FIRST IS NOT INCLUDED IN THE PROJECT AND THE FINAL VERSION IS WRITTEN INSIDE THE MAIN PROJECT FILES. THIS IS A TEST FILE FOR THE JOYSTICK FUNCTIONALITY, AND IS NOT INCLUDED IN THE FINAL PROJECT.


#if defined(ARDUINO) || defined(ARDUINO_ARCH_AVR) || defined(ARDUINO_ARCH_ESP32) || defined(ARDUINO_ARCH_ESP8266)
#include <Arduino.h>
#else
#include <stdint.h>
#include <stdbool.h>

#define HIGH 0x1
#define LOW 0x0
#define INPUT_PULLUP 0x2
#define A0 0
#define A1 1
#define A2 2

static inline unsigned long millis() { return 0UL; }
static inline int analogRead(int) { return 0; }
static inline int digitalRead(int) { return HIGH; }
static inline void pinMode(int, int) {}
struct SerialClass { void begin(int) {} void println(const char*) {} } Serial;
#endif

//define names of action states as type joystickPos
typedef enum {
    UP,
    DOWN,
    LEFT,
    RIGHT,
    NONE,
    CLICK,
} joystickPos;

//function prototypes
joystickPos readJoystick();

//pin assignments
const int VRX_PIN = A0;
const int VRY_PIN = A1;
const int SW_PIN = A2;

//track last state and timing
joystickPos lastJoyState = NONE; //where centre is no input
unsigned long lastButPress = 0;
unsigned long currentButPress;
unsigned long nextMoveTime = 0; //countdown to next registered movement
bool isHolding = false;
int countdown; //dynamically change the countdown based on last movement time

//setup function
void setup() {
    Serial.begin(9600);
    pinMode(SW_PIN, INPUT_PULLUP);
    Serial.println("Setup success");
}

//main loop - just for
void loop() {
    
    //call readJoystick function
    joystickPos current = readJoystick();
    
    if(current == UP) Serial.println("Up");
    if(current == DOWN) Serial.println("Down");
    if(current == LEFT) Serial.println("Left");
    if(current == RIGHT) Serial.println("Right");
    if(current == CLICK) Serial.println("Click");
}

//read the value on joystick and return as a joystickPos type
joystickPos readJoystick() {
    
    int xPos = analogRead(VRX_PIN);
    int yPos = analogRead(VRY_PIN);
    int buttonState = digitalRead(SW_PIN);
    
    //check for a button push
    if(buttonState == LOW && lastJoyState != CLICK) {
        
        currentButPress = millis();
        
        //debounce click
        if(currentButPress - lastButPress > 50) {
            
            //pass current press time to last time press; pass to lastJoyState; tell loop that there was a click
            lastButPress = currentButPress;
            lastJoyState = CLICK;
            return(CLICK);
        }
    }
    
    //block directions if the countdown to the next registered movement isn't done
    if(millis() < nextMoveTime) {return(NONE);}
    
    //set a countdown based on last movement and have isHolding = true by default
    countdown = isHolding ? 150 : 400;
    nextMoveTime = millis() + countdown;

    // If in centre and only if button isn't held, set state to none
    if (xPos >= 200 && xPos <= 800 && yPos >= 200 && yPos <= 800 && buttonState == HIGH) {
            
        lastJoyState = NONE;
        isHolding = false;
        nextMoveTime = 0;
    }
    
    //zones:
        //down: (200-800, >=800)
        //up: (200-800, <=200)
        //left: (<=200, 200-800)
        //right: (>=800, 200-800)
        //corner: both <=200, both >=800, (<=200, >=800), or (>=800, <=200) - dead zone
        //centre: (200-800, 200-800) - dead zone
        
    //down position
    if(xPos >= 200 && xPos <= 800 && yPos >= 800) {
        //pass current state into last state
        lastJoyState = DOWN;
        isHolding = true;
        return(DOWN);
    }
    
    //up position
    else if(xPos >= 200 && xPos <= 800 && yPos <= 200) {
        lastJoyState = UP;
        isHolding = true;
        return(UP);
    }
    
    //left position
    else if(yPos >= 200 && yPos <= 800 && xPos <= 200) {
        lastJoyState = LEFT;
        isHolding = true;
        return(LEFT);
    }
    
    //right position
    else if(yPos >= 200 && yPos <= 800 && xPos >= 800) {
        lastJoyState = RIGHT;
        isHolding = true;
        return(RIGHT);
    }
    
    //clear corners
    else {return(NONE);}
}