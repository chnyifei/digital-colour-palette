// --- Base hues ---
uint16_t basehues565[10] = {
    0xFEA3,  // CLAY_YELLOW
    0xF800,  // CLAY_RED
    0xF010,  // CLAY_MAGENTA
    0x64B7,  // CLAY_BLUE
    0x05EF,  // CLAY_GREEN
