};

// --- Pigment strengths (tentative on black and white) ---
// B/W removed b/c not useful -- their strengths for each individual tint/shade are
// adjustable below in blendDisplayColour in vars tintShadeStr
float pigmentStrength[7] = {0.30f, 0.75f, 1.25f, 0.50f, 1.50f};

// ---Naming ---
const char* clayNames[7] = {"Y", "R", "M", "B", "G", "W", "K"};

// --- Conversion helpers ---
void rgb565to888(uint16_t colour565, uint8_t &r, uint8_t &g, uint8_t &b) {
    r = (colour565 >> 11) & 0x1F;
    g = (colour565 >> 5)  & 0x3F;
    b = (colour565 >> 0)  & 0x1F;
    r = (r << 3) | (r >> 2);
    g = (g << 2) | (g >> 4);
    b = (b << 3) | (b >> 2);
}

uint16_t rgb888to565(uint8_t r, uint8_t g, uint8_t b) {
    uint16_t r5 = (r >> 3) & 0x1F;
    uint16_t g6 = (g >> 2) & 0x3F;
    uint16_t b5 = (b >> 3) & 0x1F;
    return (r5 << 11) | (g6 << 5) | b5;
}

// --- Minimal struct just for this test (mirrors your mixResult.ratio[7]) ---
typedef struct {
    float ratio[7];
} testRatios;

// --- Function prototypes ---
uint16_t blendDisplayColour(testRatios ratios, int tintShade);
testRatios buildMix(testRatios base, int tintShade);

// --- Blend hues, then blend black and white if necessary ---
uint16_t blendDisplayColour(testRatios ratios, int tintShade) {
    
    float rAcc = 0, gAcc = 0, bAcc = 0, totalParts = 0;
    
    // Go through the hues, break into 888 RGB, add up
    for(int i = 0; i < 5; i++) {
        
        if(ratios.ratio[i] <= 0) continue;
        uint8_t r, g, b;
        
        // Send the base clay hue to unpack to 888; replace values in rgb vars
        rgb565to888(basehues565[i], r, g, b);
        rAcc += (r * ratios.ratio[i] * pigmentStrength[i]);
        gAcc += (g * ratios.ratio[i] * pigmentStrength[i]);
        bAcc += (b * ratios.ratio[i] * pigmentStrength[i]);
        totalParts += ratios.ratio[i] * pigmentStrength[i];
    }
    
    float hueTotalParts = totalParts; // capture BEFORE black/white touch totalParts

    // Check for error -- shouldn't happen here
    if (totalParts == 0) {
        return 0xB0CF; // error colour
    }

    // Check for black/white in the target colour and calculate accordingly
    if (tintShade != 0) {

        float tintShadeStr;
        uint8_t r, g, b;

        if (tintShade < 0) {

            float desatStr;

            if (tintShade == -3) { tintShadeStr = 0.65; desatStr = 1.3; rgb565to888(basehues565[9], r, g, b); }
            if (tintShade == -2) { tintShadeStr = 0.5; desatStr = 0.9; rgb565to888(basehues565[8], r, g, b); }
            if (tintShade == -1) { tintShadeStr = 0.25; desatStr = 0.4; rgb565to888(basehues565[7], r, g, b); }

            // Desat
            rAcc += (r * desatStr * hueTotalParts);
            gAcc += (g * desatStr * hueTotalParts);
            bAcc += (b * desatStr * hueTotalParts);
            totalParts += desatStr * hueTotalParts;

            // Black
            rgb565to888(basehues565[6], r, g, b);
            rAcc += (r * ratios.ratio[6] * tintShadeStr * hueTotalParts);
            gAcc += (g * ratios.ratio[6] * tintShadeStr * hueTotalParts);
            bAcc += (b * ratios.ratio[6] * tintShadeStr * hueTotalParts);
            totalParts += ratios.ratio[6] * tintShadeStr * hueTotalParts;
        }

        else {
            if (tintShade == 1) {tintShadeStr = 0.5;}
            if (tintShade == 2) {tintShadeStr = 1.3;}
            if (tintShade == 3) {tintShadeStr = 3.2;}

            // White
            rgb565to888(basehues565[5], r, g, b);
            rAcc += (r * ratios.ratio[5] * tintShadeStr * hueTotalParts);
            gAcc += (g * ratios.ratio[5] * tintShadeStr * hueTotalParts);
            bAcc += (b * ratios.ratio[5] * tintShadeStr * hueTotalParts);
            totalParts += ratios.ratio[5] * tintShadeStr * hueTotalParts;
    }
}
    
    // Average values
    float rResult = roundf(rAcc / totalParts);
    float gResult = roundf(gAcc / totalParts);
    float bResult = roundf(bAcc / totalParts);
    
    // Cap at 255 and 0
    rResult = (rResult < 0 ? 0 : rResult > 255 ? 255 : rResult);
    gResult = (gResult < 0 ? 0 : gResult > 255 ? 255 : gResult);
    bResult = (bResult < 0 ? 0 : bResult > 255 ? 255 : bResult);
    
    // Pack to 565 and return
    uint8_t rFinal = (uint8_t)rResult;
    uint8_t gFinal = (uint8_t)gResult;
    uint8_t bFinal = (uint8_t)bResult;
    return rgb888to565(rFinal, gFinal, bFinal);
}

// --- Grid config: 4 hues (columns) x 7 tint/shade levels (rows) ---

// THE CODE BELOW THIS IS ONLY FOR TESTING

struct hueDef {
    const char* label;
    testRatios base; // only indices 0-4 populated; 5 and 6 left at 0
};

hueDef testHues[5] = {
    {"R",   {{0,  1, 0, 0,  0, 0, 0}}},
    {"YI",  {{80, 2, 0, 0,  0, 0, 0}}},
    {"MIV", {{0,  0, 1, 15, 0, 0, 0}}},
    {"BI",  {{0,  0, 0, 9,  2, 0, 0}}},
    {"GII", {{8,  0, 0, 0,  1, 0, 0}}}
};

int shadeSteps[7] = {-3, -2, -1, 0, 1, 2, 3};

testRatios buildMix(testRatios base, int tintShade) {
    testRatios result = base;
    if (tintShade < 0) {
        result.ratio[6] = 1; // flag black
    } else if (tintShade > 0) {
        result.ratio[5] = 1; // flag white
    }
    return result;
}

void setup() {
    SPI.setSCK(18);
    SPI.setTX(19);

    tft.begin();
    tft.setRotation(1); // landscape, 320x240
    tft.fillScreen(ILI9341_BLACK);
    tft.setTextColor(ILI9341_WHITE);
    tft.setTextSize(1);

    int gridX = 10, gridY = 20;
    int blockW = 58, blockH = 26;
    int gapX = 4, gapY = 2;

    for (int col = 0; col < 5; col++) {
        // Column header (hue label)
        int headerX = gridX + col * (blockW + gapX);
        tft.setCursor(headerX, 5);
        tft.print(testHues[col].label);

        for (int row = 0; row < 7; row++) {
            int tintShade = shadeSteps[row];
            testRatios mix = buildMix(testHues[col].base, tintShade);
            uint16_t colour = blendDisplayColour(mix, tintShade);

            int x = gridX + col * (blockW + gapX);
            int y = gridY + row * (blockH + gapY);

            tft.fillRect(x, y, blockW, blockH, colour);
        }
    }

    // Row labels down the left edge
    for (int row = 0; row < 7; row++) {
        int y = gridY + row * (blockH + gapY) + (blockH / 2) - 3;
        tft.setCursor(1, y);
        tft.print(shadeSteps[row]);
    }
}

